# Copy to .env.local for local testing (no Clerk required if you leave publishable key empty).
#
# Full API base URL including /api/v1 — must match the Go API (default port 8080).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Explicit dev mode (optional if CLERK_PUBLISHABLE_KEY is unset — same header-auth behavior).
NEXT_PUBLIC_DEV_MODE=true

# Dev auth headers — must match backend allowDevBypass + seeded tenant in Postgres.
NEXT_PUBLIC_DEV_USER_ID=00000000-0000-0000-0000-000000000001
NEXT_PUBLIC_DEV_TENANT_ID=00000000-0000-0000-0000-000000000001

# Clerk (optional for local stack testing). When set, use a real key and remove NEXT_PUBLIC_DEV_MODE.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
